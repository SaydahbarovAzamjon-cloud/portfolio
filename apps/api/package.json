    "@nestjs/core": "^12.6.0",
    "@nestjs/graphql": "^14.2.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/throttler": "^6.8.0",
    "@node-rs/argon2": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "graphql": "^16.15.0",
    "joi": "^18.3.2",
    "mongoose": "^9.12.2",
