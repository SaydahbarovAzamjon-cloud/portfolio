# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/portfolio

# Telegram notifications
# 1) Telegram -> @BotFather -> /newbot -> copy the token
# 2) Send /start to your new bot, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = message for every new visitor; false = only in the daily report
TELEGRAM_NOTIFY_VISITS=true
# Hour (0-23, Asia/Seoul) for the daily likes/visits report
DAILY_REPORT_HOUR=21

# Email (Resend: resend.com -> API Keys)
RESEND_API_KEY=
# Without a verified domain use: Portfolio <onboarding@resend.dev>
MAIL_FROM=
# Where contact-form notifications are delivered
MAIL_TO=

# Authentication
# Long random string, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Max login attempts per IP within LOGIN_RATE_TTL_SECONDS
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_SECONDS=60

# Admin account (used once by: pnpm seed:admin). Remove the password after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
